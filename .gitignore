# Virtual environment
.venv/
__pycache__/
*.pyc

# Credentials — .env.txt holds the VCC API token
.env.txt
*.key

# Challenge data and derived artifacts: large, and all re-downloadable
# (`vcc datasets download`, or src/rehearsal.py for the 2025 splits).
data/
external/
*.zip
*.h5ad
*.vcc
*.ckpt
*.npz
*.parquet
*.pt

# Modal FunctionCall ids and run logs: per-session scratch, not source.
.*_call
.*_calls
.rep_fast_smoke
.tr_recall
.tr_score
.ens_fc
.ens_score
.prep_call
.blend_call
.send_call
*.log
